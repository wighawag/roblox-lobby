--!strict
local Fakes = require("./fakes")
local Fixtures = require("./fixtures")
local Lobby = require("../src/Lobby")

local function setup(over: any?, options: any?)
	local w = Fakes.world(over)
	local opts = options or {}
	opts.env = w.env
	local lobby = Lobby.start(Fixtures.config(), opts)
	local events = { launched = {}, failed = {}, notices = {}, changed = 0 }
	lobby.Launched:Connect(function(party)
		table.insert(events.launched, party)
	end)
	lobby.LaunchFailed:Connect(function(party, players, reason)
		table.insert(events.failed, { party = party, players = players, reason = reason })
	end)
	lobby.Notice:Connect(function(player, msg)
		table.insert(events.notices, { player = player, msg = msg })
	end)
	lobby.Changed:Connect(function()
		events.changed += 1
	end)
	return w, lobby, events
end

local function duo(w: any, lobby: any): (any, any)
	local a, b = w.addPlayer(1), w.addPlayer(2)
	assert(lobby:join(a, "duo"))
	assert(lobby:join(b, "duo"))
	return a, b
end

return function(T)
	local it, expect = T.it, T.expect
	T.describe("Lobby adapter", function()
		it("creates the remotes and the replicated queue state", function()
			local w, lobby = setup()
			local remotes = w.instance("RobloxLobbyRemotes")
			expect(remotes.Parent).toBe(w.ReplicatedStorage)
			local f = w.instance("four")
			expect(f:GetAttribute("Capacity")).toBe(4)
			lobby:join(w.addPlayer(7), "four")
			expect(f:GetAttribute("Count")).toBe(1)
			expect(f:GetAttribute("Members")).toBe("7")
		end)

		it("teleports a full party into one reserved server with the envelope", function()
			local w, lobby, ev = setup(nil, {
				teleportData = function(party)
					return { mode = "classic", n = #party.members }
				end,
			})
			duo(w, lobby)
			w.advance(10)
			lobby:_step()
			expect(#w.teleports).toBe(1)
			local t = w.teleports[1]
			expect(t.placeId).toBe(106268450656854)
			expect(#t.players).toBe(2)
			expect(t.options.ReservedServerId).toBe("GUID-1")
			local data = t.options:GetTeleportData()
			expect(data.rl).toBe(1)
			expect(data.matchId).toBe("GUID-1")
			expect(data.members).toEqual({ 1, 2 })
			expect(data.lobbyPlaceId).toBe(74888767056358)
			expect(data.data).toEqual({ mode = "classic", n = 2 })
			expect(#ev.launched).toBe(1)
			expect(ev.launched[1].simulated).toBe(false)
			expect(w.instance("duo"):GetAttribute("Count")).toBe(0)
		end)

		it("does not launch before the countdown ends (queue not full)", function()
			local w, lobby = setup()
			lobby:join(w.addPlayer(1), "four")
			lobby:join(w.addPlayer(2), "four")
			w.advance(19)
			lobby:_step()
			expect(#w.teleports).toBe(0)
			expect(w.instance("four"):GetAttribute("Phase")).toBe("counting")
			expect(w.instance("four"):GetAttribute("SecondsLeft")).toBe(1)
			w.advance(1)
			lobby:_step()
			expect(#w.teleports).toBe(1)
		end)

		it("a player who quits during the countdown resets it", function()
			local w, lobby = setup()
			local a = duo(w, lobby)
			w.removePlayer(a)
			w.advance(20)
			lobby:_step()
			expect(#w.teleports).toBe(0)
			expect(w.instance("duo"):GetAttribute("Count")).toBe(1)
		end)

		it("cancels a launch that lost players and requeues the rest", function()
			local w, lobby, ev = setup()
			local a = w.addPlayer(1)
			lobby:join(a, "duo")
			local b = w.addPlayer(2)
			lobby:join(b, "duo")
			w.advance(10)
			-- b disappears without PlayerRemoving having run yet (a race on a real server)
			local i = table.find(w.Players:GetPlayers(), b)
			w.Players.GetPlayers = function()
				return { a }
			end
			w.Players.GetPlayerByUserId = function(_, id)
				return if id == 1 then a else nil
			end
			lobby:_step()
			expect(#w.teleports).toBe(0)
			expect(#ev.launched).toBe(0)
			expect(lobby:queueOf(a)).toBe("duo")
			expect(i ~= nil).toBe(true)
		end)

		it("retries a thrown TeleportAsync error with backoff", function()
			local w, lobby, ev = setup()
			duo(w, lobby)
			local calls = 0
			w.teleportBehaviour = function()
				calls += 1
				if calls < 3 then
					error("HTTP 500")
				end
				return nil
			end
			w.advance(10)
			lobby:_step()
			expect(calls).toBe(1)
			w.advance(1)
			expect(calls).toBe(2)
			w.advance(2)
			expect(calls).toBe(3)
			expect(#ev.launched).toBe(1)
		end)

		it("does not retry a permanent error (a wrong place id answers HTTP 400) and says why", function()
			local w, lobby, ev = setup()
			duo(w, lobby)
			w.teleportBehaviour = function()
				error("HTTP 400 (Bad Request)")
			end
			w.advance(10)
			lobby:_step()
			expect(#w.teleports).toBe(1)
			expect(#ev.failed).toBe(2)
			expect(string.find(ev.notices[1].msg, "place id", 1, true) ~= nil).toBe(true)
			expect(w.warned("roblox-lobby check")).toBe(true)
		end)

		it("gives up after 5 thrown errors, tells the players, frees them", function()
			local w, lobby, ev = setup()
			local a, b = duo(w, lobby)
			w.teleportBehaviour = function()
				error("down")
			end
			w.advance(10)
			lobby:_step()
			w.advance(60)
			expect(#w.teleports).toBe(5)
			expect(#ev.failed).toBe(2)
			expect(#ev.notices).toBe(2)
			local notice = w.instance("Notice")
			expect(#notice.sent).toBe(2)
			expect(lobby:join(a, "duo")).toBe(true)
			expect(lobby:join(b, "four")).toBe(true)
		end)

		it("retries a Flooded player to the SAME reserved server after 15 s", function()
			local w, lobby, ev = setup()
			local a = duo(w, lobby)
			w.advance(10)
			lobby:_step()
			w.initFailed(a, "Flooded")
			w.advance(14)
			expect(#w.teleports).toBe(1)
			w.advance(1)
			expect(#w.teleports).toBe(2)
			local retry = w.teleports[2]
			expect(#retry.players).toBe(1)
			expect(retry.players[1]).toBe(a)
			expect(retry.options).toBe(w.teleports[1].options)
			expect(#ev.failed).toBe(0)
		end)

		it("releases a player on a final failure with a clear message", function()
			local w, lobby, ev = setup()
			local a = duo(w, lobby)
			w.advance(10)
			lobby:_step()
			w.initFailed(a, "Unauthorized")
			expect(#ev.failed).toBe(1)
			expect(ev.failed[1].reason).toBe("Unauthorized")
			expect(string.find(ev.notices[1].msg, "refused", 1, true) ~= nil).toBe(true)
			expect(lobby:join(a, "duo")).toBe(true)
		end)

		it("stops retrying after 3 failures", function()
			local w, lobby, ev = setup()
			local a = duo(w, lobby)
			w.advance(10)
			lobby:_step()
			for _ = 1, 3 do
				w.initFailed(a, "Failure")
				w.advance(1)
			end
			expect(#ev.failed).toBe(0)
			w.initFailed(a, "Failure")
			expect(#ev.failed).toBe(1)
			expect(ev.failed[1].reason).toBe("retries-exhausted")
			expect(#w.teleports).toBe(4)
		end)

		it("treats a silent failure as failed after 30 s; departed players are just settled", function()
			local w, lobby, ev = setup()
			local a, b = duo(w, lobby)
			w.advance(10)
			lobby:_step()
			w.removePlayer(b) -- b teleported
			w.advance(30)
			lobby:_step()
			expect(#ev.failed).toBe(1)
			expect(ev.failed[1].players[1]).toBe(a)
		end)

		it("ignores TeleportInitFailed for players it did not launch", function()
			local w, _, ev = setup()
			w.initFailed(w.addPlayer(5), "Failure")
			expect(#ev.failed).toBe(0)
		end)

		it("joins and leaves through the Request remote, rate limited, ignoring bad input", function()
			local w, lobby = setup()
			local p = w.addPlayer(3)
			local request = w.instance("Request")
			request.OnServerEvent:Fire(p, "join", "four")
			expect(lobby:queueOf(p)).toBe("four")
			request.OnServerEvent:Fire(p, "leave")
			expect(lobby:queueOf(p)).toBe("four") -- too soon
			w.advance(1)
			request.OnServerEvent:Fire(p, "leave")
			expect(lobby:queueOf(p)).toBe(nil)
			w.advance(1)
			request.OnServerEvent:Fire(p, "join", 42)
			w.advance(1)
			request.OnServerEvent:Fire(p, "explode")
			expect(lobby:queueOf(p)).toBe(nil)
			w.advance(1)
			request.OnServerEvent:Fire(p, "join", "nope")
			expect(#w.instance("Notice").sent).toBe(1)
		end)

		it("warns loudly when published into the wrong experience", function()
			local w = setup({ gameId = 123 })
			expect(w.warned("wrong experience")).toBe(true)
		end)

		it("survives a failing teleportData function", function()
			local w, lobby, ev = setup(nil, {
				teleportData = function()
					error("oops")
				end,
			})
			duo(w, lobby)
			w.advance(10)
			lobby:_step()
			expect(#ev.launched).toBe(1)
			expect(w.teleports[1].options:GetTeleportData().data).toBe(nil)
			expect(w.warned("teleportData function failed")).toBe(true)
		end)
	end)

	T.describe("Lobby adapter, host party", function()
		local function hostSetup()
			local raw = Fixtures.config()
			table.insert(raw.queues, {
				id = "party",
				place = "game",
				minPlayers = 1,
				maxPlayers = 5,
				size = "host",
				hostOptions = { { id = "map", choices = { "Random", "Snow" } } },
			})
			local w = Fakes.world()
			local lobby = Lobby.start(raw, { env = w.env })
			return w, lobby
		end

		it("replicates the host, the chosen size and options, and carries them to the game", function()
			local w, lobby = hostSetup()
			local a, b = w.addPlayer(1), w.addPlayer(2)
			lobby:join(a, "party")
			local f = w.instance("party")
			expect(f:GetAttribute("Phase")).toBe("creating")
			expect(f:GetAttribute("Host")).toBe(1)
			expect(f:GetAttribute("SizeMode")).toBe("host")
			expect(string.find(f:GetAttribute("HostOptions"), "Snow", 1, true) ~= nil).toBe(true)
			local ok, reason = lobby:join(b, "party")
			expect(ok).toBe(false)
			expect(Lobby.explainJoin(reason)).toBe("The party is being created: wait for its host to choose.")
			-- the host answers through the remote
			w.instance("Request").OnServerEvent:Fire(a, "configure", "party", { size = 2, options = { map = "Snow" } })
			expect(f:GetAttribute("Capacity")).toBe(2)
			expect(f:GetAttribute("Phase")).toBe("waiting")
			expect(string.find(f:GetAttribute("Options"), "Snow", 1, true) ~= nil).toBe(true)
			expect(lobby:join(b, "party")).toBe(true)
			w.advance(5)
			lobby:_step()
			local data = w.teleports[1].options:GetTeleportData()
			expect(data.options).toEqual({ map = "Snow" })
			expect(#data.members).toBe(2)
		end)

		it("rejects a configure from a non-host or with bad values, with a notice", function()
			local w, lobby = hostSetup()
			local a, b = w.addPlayer(1), w.addPlayer(2)
			lobby:join(a, "party")
			local request = w.instance("Request")
			request.OnServerEvent:Fire(b, "configure", "party", { size = 2 })
			w.advance(1)
			request.OnServerEvent:Fire(a, "configure", "party", { size = 9 })
			w.advance(1)
			request.OnServerEvent:Fire(a, "configure", "party", "nonsense")
			local sent = w.instance("Notice").sent
			expect(#sent).toBe(3)
			expect(w.instance("party"):GetAttribute("Phase")).toBe("creating")
		end)
	end)

	T.describe("Lobby adapter in Studio", function()
		it("simulates the teleport for a local file and releases the party", function()
			local w, lobby, ev = setup({ isStudio = true, gameId = 0, placeId = 0 })
			local a = duo(w, lobby)
			w.advance(10)
			lobby:_step()
			expect(#w.teleports).toBe(0)
			expect(#ev.launched).toBe(1)
			expect(ev.launched[1].simulated).toBe(true)
			expect(w.logged("SIMULATED teleport (local file)")).toBe(true)
			expect(lobby:join(a, "four")).toBe(false)
			w.advance(3)
			expect(lobby:join(a, "four")).toBe(true)
		end)

		it("tries a real teleport on a cloud place, once, and simulates when Studio refuses", function()
			local w, lobby, ev = setup({ isStudio = true })
			duo(w, lobby)
			w.teleportBehaviour = function()
				error("TeleportPartyAsync error: Doesn't support a guest")
			end
			w.advance(10)
			lobby:_step()
			expect(#w.teleports).toBe(1)
			expect(ev.launched[1].simulated).toBe(true)
			expect(w.logged("Studio refused the real teleport")).toBe(true)
		end)

		it("does a real teleport when Studio allows it", function()
			local w, lobby, ev = setup({ isStudio = true })
			duo(w, lobby)
			w.advance(10)
			lobby:_step()
			expect(#w.teleports).toBe(1)
			expect(ev.launched[1].simulated).toBe(false)
		end)
	end)
end
